---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Img from '../../../components/Img.astro';
import Icon from '../../../components/Icon.astro';
import Price from '../../../components/Price.astro';
import ActivityCard from '../../../components/ActivityCard.astro';
import InquiryForm from '../../../components/InquiryForm.astro';
import { fmt, formatDate, hoursLabel, langs, pick, url, useTranslations, type Lang } from '../../../i18n';
import { activities } from '../../../data/activities';
import { getDestination } from '../../../data/destinations';
import { phrase } from '../../../data/phrases';
import { whatsappLink } from '../../../config/site';
import type { Activity } from '../../../data/types';

export function getStaticPaths() {
  return langs.flatMap((lang) => activities.map((activity) => ({ params: { lang, slug: activity.slug }, props: { activity } })));
}
const { activity: a } = Astro.props as { activity: Activity };
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const title = pick(a.title, lang);
const dest = getDestination(a.destination);
const place = pick(dest?.name, lang);
const related = activities.filter((x) => x.slug !== a.slug && (x.category === a.category || x.destination === a.destination)).slice(0, 3);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: title,
  description: pick(a.summary, lang),
  address: { '@type': 'PostalAddress', addressLocality: place, addressCountry: 'TR' },
};
---
<BaseLayout lang={lang} title={title} description={pick(a.summary, lang)} image={a.image} jsonLd={ld}>
  <PageHero lang={lang} title={title} eyebrow={t.activityCategory[a.category]} lead={pick(a.summary, lang)} image={a.image} crumbs={[{ label: t.nav.activities, href: url(lang, 'activities') }, { label: title }]}>
    <div class="page-hero__meta">
      <span class="badge"><Icon name="clock" />{hoursLabel(lang, a.hours)}</span>
      <span class="badge"><Icon name="pin" />{place}</span>
      {a.offer && <span class="badge badge--offer"><Icon name="tag" />{fmt(t.common.save, { n: a.offer.discount })}</span>}
    </div>
  </PageHero>

  <div class="container detail section">
    <div>
      <section class="detail-section" aria-labelledby="h-about">
        <h2 id="h-about">{t.activity.about}</h2>
        <p class="lead">{pick(a.description, lang)}</p>
        <dl class="facts">
          <div><dt>{t.common.duration}</dt><dd>{hoursLabel(lang, a.hours)}</dd></div>
          <div><dt>{t.common.location}</dt><dd>{dest ? <a href={url(lang, `destinations/${dest.slug}`)}>{place}</a> : place}</dd></div>
          <div><dt>{t.common.category}</dt><dd>{t.activityCategory[a.category]}</dd></div>
          <div><dt>{t.tour.pricing}</dt><dd><Price lang={lang} amount={a.priceFrom} offer={a.offer} /></dd></div>
        </dl>
        <div class="two-col">
          <div class="box">
            <h3>{t.activity.includes}</h3>
            <ul class="checklist" style="margin:0">{a.includes.map((i) => <li><Icon name="check-circle" />{phrase(i, lang)}</li>)}</ul>
          </div>
          <div class="box">
            <h3>{t.activity.meetingPoint}</h3>
            <p style="display:flex;gap:10px;margin:0"><Icon name="pin" class="" />{pick(a.meetingPoint, lang)}</p>
          </div>
        </div>
        {a.goodToKnow && a.goodToKnow.length > 0 && (
          <>
            <h3 style="margin:28px 0 12px">{t.activity.goodToKnow}</h3>
            <ul class="checklist">{a.goodToKnow.map((g) => <li><Icon name="info" />{pick(g, lang)}</li>)}</ul>
          </>
        )}
      </section>
      <section id="inquiry" aria-label={t.activity.inquireTitle}>
        <InquiryForm lang={lang} product={`activity:${a.slug}`} title={t.activity.inquireTitle} compact />
      </section>
    </div>
    <aside class="detail__aside">
      <Img image={a.image} alt={title} sizes="380px" widths={[400, 760]} class="" />
      <div class="price-box">
        <Price lang={lang} amount={a.priceFrom} offer={a.offer} />
        {a.offer && <p class="hint" style="color:#b9c2c6;margin:8px 0 0">{fmt(t.common.validUntil, { date: formatDate(a.offer.validUntil, lang) })}</p>}
        <hr />
        <ul>
          <li><Icon name="clock" />{hoursLabel(lang, a.hours)}</li>
          <li><Icon name="pin" />{place}</li>
          <li><Icon name="shield" />{t.form.notice}</li>
        </ul>
        <a class="btn btn--gold btn--block" href="#inquiry">{t.common.inquire} <Icon name="arrow-right" /></a>
        <a class="btn btn--whatsapp btn--block" href={whatsappLink(`${t.activity.inquireTitle}: ${title}`)} target="_blank" rel="noopener"><Icon name="whatsapp" />{t.common.chatWhatsapp}</a>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="section section--sand" aria-labelledby="h-rel">
      <div class="container">
        <div class="section-head"><div><span class="eyebrow">{t.nav.activities}</span><h2 id="h-rel">{t.activity.related}</h2></div></div>
        <div class="grid grid--3">{related.map((x) => <ActivityCard activity={x} lang={lang} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
