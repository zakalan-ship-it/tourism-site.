---
import Img from './Img.astro';
import { url, useTranslations, type Lang } from '../i18n';

interface Crumb { label: string; href?: string }
interface Props {
  lang: Lang;
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: string;
  crumbs?: Crumb[];
}
const { lang, title, eyebrow, lead, image, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
const trail: Crumb[] = [{ label: t.nav.home, href: url(lang) }, ...crumbs];
const site = Astro.site?.href ?? 'https://www.wellxplore.com/';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, item: c.href ? new URL(c.href, site).href : undefined })),
};
---
<section class:list={['page-hero', { 'page-hero--plain': !image }]}>
  {image && <Img image={image} alt="" sizes="100vw" widths={[800, 1400, 2000]} eager />}
  <div class="container">
    <nav class="breadcrumbs" aria-label={t.nav.breadcrumb}>
      <ol>
        {trail.map((c, i) => (
          <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
        ))}
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</section>
