---
import { Picture } from 'astro:assets';
import { getImage } from '../data/images';
import Icon from './Icon.astro';

interface Props {
  image?: string;
  alt: string;
  class?: string;
  /** Approximate rendered width, e.g. '(max-width: 640px) 100vw, 33vw' */
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  /** Image quality 1–100 (default 72). Use ~90 for your own photos. */
  quality?: number;
}
const { image, alt, class: className = '', sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw', widths = [400, 700, 1000, 1400], eager = false, quality = 72 } = Astro.props;
const meta = getImage(image);
const usable = meta ? widths.filter((w) => w <= meta.width) : [];
// Always offer the full original size when it is smaller than the largest size requested.
if (meta && !usable.includes(meta.width) && widths.some((w) => w > meta.width)) usable.push(meta.width);
---
{meta ? (
  <div class={`img-frame ${className}`}>
    <Picture
      src={meta}
      alt={alt}
      widths={usable}
      sizes={sizes}
      formats={['webp']}
      fallbackFormat="jpg"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      quality={quality}
    />
  </div>
) : (
  <div class={`img-frame img-frame--placeholder ${className}`} role="img" aria-label={alt}>
    <Icon name="star8" />
  </div>
)}
