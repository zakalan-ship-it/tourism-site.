---
import ChatButton from './ChatButton.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-full-light.png';
import { languages, langs, pick, url, switchLangPath, useTranslations, type Lang } from '../i18n';
import { destinations } from '../data/destinations';
import { site } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
const year = new Date().getFullYear();
// International channels on /en/; Chinese platforms on /zh/ (Facebook, Instagram, YouTube are blocked in mainland China).
const channelSets = {
  en: [['instagram', 'Instagram'], ['facebook', 'Facebook'], ['youtube', 'YouTube'], ['tripadvisor', 'Tripadvisor']],
  zh: [['xiaohongshu', '小红书'], ['douyin', '抖音'], ['weibo', '微博']],
} as const;
const socials = channelSets[lang].filter(([k]) => site.social[k]);
const iconFor: Record<string, string> = { instagram: 'instagram', facebook: 'facebook', youtube: 'youtube' };
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url(lang)} aria-label="WellXplore — home">
          <Image class="brand__logo-full" src={logo} alt="WellXplore — Connecting Cultures, Creating Memories." widths={[240, 480, 720]} sizes="240px" format="webp" quality={90} />
        </a>
        <p>{t.footer.about}</p>
        {socials.length > 0 && (
          <div class="socials" aria-label={t.footer.follow}>
            {socials.map(([k, label]) => (iconFor[k]
              ? <a href={site.social[k]} target="_blank" rel="noopener" aria-label={label}><Icon name={iconFor[k]} /></a>
              : <a class="socials__text" href={site.social[k]} target="_blank" rel="noopener">{label}</a>))}
          </div>
        )}
        <nav class="footer-langs" aria-label={t.nav.language}>
          {langs.map((l) => (
            <a href={switchLangPath(path, l)} lang={languages[l].htmlLang} hreflang={languages[l].htmlLang} aria-current={l === lang ? 'true' : undefined} data-lang-link={l}>{languages[l].label}</a>
          ))}
        </nav>
      </div>

      <div>
        <h2>{t.footer.explore}</h2>
        <ul>
          <li><a href={url(lang, 'tours')}>{t.nav.tours}</a></li>
          <li><a href={url(lang, 'activities')}>{t.nav.activities}</a></li>
          <li><a href={url(lang, 'transfers')}>{t.nav.transfers}</a></li>
          <li><a href={url(lang, 'offers')}>{t.nav.offers}</a></li>
          <li><a href={url(lang, 'catalogue')}>{t.nav.catalogue}</a></li>
        </ul>
      </div>

      <div>
        <h2>{t.nav.destinations}</h2>
        <ul>
          {destinations.slice(0, 6).map((d) => (<li><a href={url(lang, `destinations/${d.slug}`)}>{pick(d.name, lang)}</a></li>))}
          <li><a href={url(lang, 'destinations')}>{t.nav.allDestinations} →</a></li>
        </ul>
      </div>

      <div>
        <h2>{t.footer.company}</h2>
        <ul>
          <li><a href={url(lang, 'about')}>{t.nav.about}</a></li>
          <li><a href={url(lang, 'contact')}>{t.nav.contact}</a></li>
          <li><a href={url(lang, 'inquiry')}>{t.nav.inquiry}</a></li>
          <li><a href={url(lang, 'contact') + '#partners'}>{t.contact.partnersTitle}</a></li>
        </ul>
      </div>

      <div class="footer-contact">
        <h2>{t.footer.contact}</h2>
        <ul class="contact-list">
          <li><Icon name="pin" /><span>{site.contact.address.line1}<br />{site.contact.address.line2}, {site.contact.address.country}</span></li>
          <li><Icon name="phone" /><a href={`tel:${site.contact.phoneHref}`}>{site.contact.phoneDisplay}</a></li>
          <li><Icon name={lang === 'zh' ? 'wechat' : 'whatsapp'} /><ChatButton lang={lang} variant="link" class="footer-chat" /></li>
          <li><Icon name="mail" /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.legalName}. {t.footer.rights}{site.licence && <> · TÜRSAB {site.licence}</>}</span>
      <nav aria-label={t.footer.legal}>
        <a href={url(lang, 'privacy')}>{t.footer.privacy}</a>
        <a href={url(lang, 'terms')}>{t.footer.terms}</a>
        <a href={url(lang, 'cookies')}>{t.footer.cookies}</a>
        <button type="button" data-cookie-open>{t.footer.cookieSettings}</button>
        <a href={url(lang, 'credits')}>{t.footer.credits}</a>
      </nav>
    </div>
  </div>
</footer>
